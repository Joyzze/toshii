
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A Little Something 💌</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Georgia, serif;
    background: #fff0f3;
    color: #8f4058;
    overflow: hidden;
}

.petal {
    position: fixed;
    top: -20px;
    color: #ed9aaf;
    animation: fall linear infinite;
    pointer-events: none;
    z-index: 0;
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(360deg);
    }
}

.screen {
    position: relative;
    z-index: 1;
    width: min(90%, 440px);
    text-align: center;
    padding: 25px;
}

h1 {
    font-size: 27px;
    font-weight: normal;
}

p {
    line-height: 1.7;
}

.hidden {
    display: none !important;
}

/* ENVELOPE */

.envelope {
    position: relative;
    width: 230px;
    height: 155px;
    margin: 55px auto 35px;
    background: #e9a4b5;
    cursor: pointer;
    border-radius: 4px;
    box-shadow: 0 10px 25px #bd728540;
    transition: transform 0.3s;
}

.envelope:hover {
    transform: translateY(-6px);
}

.envelope::before {
    content: "";
    position: absolute;
    z-index: 3;
    bottom: 0;
    left: 0;
    border-left: 115px solid #f5c3cf;
    border-right: 115px solid #f5c3cf;
    border-top: 85px solid transparent;
    border-bottom: 70px solid #f0b3c2;
    border-radius: 3px;
}

.flap {
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-left: 115px solid transparent;
    border-right: 115px solid transparent;
    border-top: 90px solid #d9829b;
    transform-origin: top;
    transition: transform 0.6s;
}

.envelope.open .flap {
    transform: rotateX(180deg);
    z-index: 0;
}

.seal {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 52%;
    transform: translate(-50%, -50%);
    font-size: 28px;
}

.envelope-label {
    position: absolute;
    z-index: 6;
    width: 100%;
    top: -42px;
    left: 0;
    font-size: 19px;
    color: #994a62;
    white-space: nowrap;
}

/* CHOICES */

.choices {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 25px;
}

button {
    font-family: Georgia, serif;
    font-size: 16px;
    padding: 12px 19px;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    transition: transform 0.2s, background 0.2s;
}

button:hover {
    transform: scale(1.06);
}

.yes {
    background: #d77f99;
    color: white;
}

.no {
    background: #fff;
    color: #a3536b;
    border: 1px solid #edbdca;
}

/* LETTER */

.letter {
    background: #fffaf5;
    padding: 28px 25px;
    border: 1px solid #f3d5d9;
    border-radius: 5px;
    box-shadow: 0 8px 30px #b86b7820;
    animation: appear 0.8s ease;
    max-height: 70vh;
    overflow-y: auto;
}

.letter h2 {
    font-weight: normal;
    font-size: 25px;
}

.letter p {
    text-align: left;
    white-space: pre-line;
    font-size: 16px;
}

.angry-gif {
    width: min(100%, 280px);
    border-radius: 15px;
    margin: 15px auto;
    display: block;
}

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(15px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.small {
    font-size: 13px;
    color: #b77a8b;
}

.back {
    margin-top: 15px;
    background: transparent;
    color: #a3536b;
    text-decoration: underline;
}
</style>
</head>

<body>

<!-- FIRST SCREEN -->
<div class="screen" id="startScreen">
    <h1>a little something ♡</h1>
    <p>made just for you</p>

    <div class="envelope" id="envelope"
         onclick="showChoices()">
        <span class="envelope-label">
            a little something
        </span>
        <div class="flap"></div>
        <div class="seal">♥</div>
    </div>

    <p class="small">click the envelope to open</p>
</div>

<!-- CHOICE SCREEN -->
<div class="screen hidden" id="choiceScreen">
    <h1>well, well, well... 💌</h1>
    <p>someone has a little something for you.</p>
    <p>are you going to read it?</p>

    <div class="choices">
        <button class="yes" onclick="openLetter()">
            open me 💗
        </button>

        <button class="no" onclick="refuseLetter()">
            not open me 🙄
        </button>
    </div>
</div>

<!-- ANGRY GIF SCREEN -->
<div class="screen hidden" id="angryScreen">
    <h1>EXCUSE ME?! 😠</h1>

    <img
      class="angry-gif"
      src="https://media.tenor.com/2roX3uxz_68AAAAC/cat-angry.gif"
      alt="Angry reaction GIF"
      onerror="this.style.display='none'; document.getElementById('fallback').style.display='block';"
    >

    <div id="fallback" style="display:none;font-size:75px;">
        😾💢
    </div>

    <p>WOW. okay. so you don't love me?</p>
    <p>try again. 😤</p>

    <button class="yes" onclick="backToChoices()">
        fine, let me try again 💌
    </button>
</div>

<!-- LOVE LETTER SCREEN -->
<div class="screen hidden" id="letterScreen">
    <div class="letter">
        <h2>to my favorite person ♡</h2>

        <p>
hi, love!

i just wanted to make something little
for someone who means so much to me.

i hope this reminds you that even on
ordinary days, there is someone who
thinks about you and appreciates you
more than words can explain.

thank you for being you, for existing,
and for making my days a little brighter.

i hope you always remember how special
you are to me. no grand occasion needed.
sometimes, i just want you to know
that you are loved.

with all my love,
your favorite person ♡
        </p>

        <p style="text-align:center;">
            ♡ ♡ ♡
        </p>
    </div>

    <button class="back" onclick="restart()">
        read it again ↺
    </button>
</div>

<script>
function hideAll() {
    document.querySelectorAll(".screen").forEach(screen => {
        screen.classList.add("hidden");
    });
}

function showChoices() {
    const envelope = document.getElementById("envelope");
    envelope.classList.add("open");

    setTimeout(() => {
        hideAll();
        document.getElementById("choiceScreen")
            .classList.remove("hidden");
    }, 650);
}

function openLetter() {
    hideAll();
    document.getElementById("letterScreen")
        .classList.remove("hidden");
}

function refuseLetter() {
    hideAll();
    document.getElementById("angryScreen")
        .classList.remove("hidden");
}

function backToChoices() {
    hideAll();
    document.getElementById("choiceScreen")
        .classList.remove("hidden");
}

function restart() {
    hideAll();
    document.getElementById("envelope").classList.remove("open");
    document.getElementById("startScreen")
        .classList.remove("hidden");
}

// Floating hearts
const hearts = ["♡", "♥", "୨୧", "✿"];

for (let i = 0; i < 18; i++) {
    const heart = document.createElement("div");
    heart.className = "petal";
    heart.textContent = hearts[
        Math.floor(Math.random() * hearts.length)
    ];

    heart.style.left = Math.random() * 100 + "vw";
    heart.style.animationDuration = (6 + Math.random() * 8) + "s";
    heart.style.animationDelay = (Math.random() * 8) + "s";
    heart.style.fontSize = (14 + Math.random() * 15) + "px";

    document.body.appendChild(heart);
}
</script>

</body>
</html>
